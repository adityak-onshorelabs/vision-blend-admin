# The public site (separate deployment), e.g. https://visionblend.in or http://localhost:3000.
# The admin reads the default content from it and asks it to refresh after every save.
SITE_URL=
# Shared with the site's CMS_SECRET: 32+ random characters that authorise /api/cms on the site.
CMS_SECRET=

# Neon Postgres connection string, the same database as the site. Unset locally, the admin
# stores to CMS_DEV_FILE (default ../website/.cms-dev.json, which a local site reads).
DATABASE_URL=
# CMS_DEV_FILE=
# 32+ random characters that sign admin sessions.
SESSION_SECRET=
# Vercel Blob token for project cover uploads (needed in development too).
BLOB_READ_WRITE_TOKEN=
